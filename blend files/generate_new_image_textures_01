def get_current_obj():
    """ set correct context, make sure obj is selected and is mesh type. Return the object, not the mesh itself, at material is set per-obj not per-mesh."""

    obj = bpy.context.active_object

    if not obj or obj.type != 'MESH':
        raise RuntimeError("Select a mesh object")
        

    mat = bpy.data.materials.get(obj.name, None)
    
    if not mat:
        mat = bpy.data.materials.new(obj.name)
        mat.use_nodes = True
        obj.data.materials.append(mat)

    node_tree = mat.node_tree
        # FULL CLEAR
    #obj.active_material = mat

    return node_tree, mat



